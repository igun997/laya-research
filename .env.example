# laya-research environment
# Copy to .env and tune. Defaults in docker-compose.yml are used when unset.

# --- database ---
POSTGRES_USER=laya
POSTGRES_PASSWORD=laya
POSTGRES_DB=laya
# host port for psql access; container port is always 5432
POSTGRES_PORT=5433

# --- dataset ("little bit large datasheet") ---
# stores x products x days = row count of market_facts
LAYA_SEED=20260926
LAYA_STORES=140
LAYA_PRODUCTS=2400
LAYA_DAYS=21
# ensure = generate only if the datasheet is missing/empty
# force  = drop the facts and regenerate from LAYA_SEED
LAYA_MODE=ensure

# --- realtime simulator ---
LAYA_TICK_SECONDS=4
LAYA_TICK_ROWS=250
# rollup refresh cadence, seconds (background, CONCURRENTLY, non-blocking)
LAYA_REFRESH_SECONDS=30

# --- edge ---
LAYA_HTTP_PORT=8090
